# Abhängigkeiten
node_modules/

# Konfiguration (enthält Secrets!)
backend/.env
legacy/backend/.env

# Karten-Kacheln: zu groß für Git. Sie liegen auf dem Server unter web/tiles/
# und werden aus dem Kachel-Schneider (A:\Webserver\map\tile_cutter.js) erzeugt.
web/tiles/
frontend/tiles/
legacy/**/tiles/

# Logs
*.log
logs/

# OS-Dateien
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# PM2
.pm2/

# Temporäre Dateien
tmp/
temp/

# dist/ wird BEWUSST mitverwaltet: `npm i github:D4rkst3r/d4rk_livemap` soll nichts
# bauen muessen. Ein Build-Schritt beim Installieren braucht die Dev-Abhaengigkeiten
# und faellt genau dort um, wo niemand hinschaut — auf dem Spielserver.
