# ════════════════════════════════════════════════════════════
#   d4rk_livemap – Backend Konfiguration
#   Kopiere diese Datei zu ".env" und trage deine Werte ein.
#   WICHTIG: .env niemals in Git committen!
# ════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
# Port auf dem das Backend läuft
PORT=3001

# Vollständige URL des Backends (mit https:// in Produktion)
BACKEND_URL=https://api.deine-domain.de

# Vollständige URL des Frontends
FRONTEND_URL=https://map.deine-domain.de

# Optional: www-Variante des Frontends (verhindert CORS-Fehler)
FRONTEND_URL_WWW=https://www.map.deine-domain.de

# ── FiveM ────────────────────────────────────────────────────
# URL deines FiveM-Servers
# Option A: Direkter Zugriff (Firewall muss Port erlauben)
#   FIVEM_URL=http://DEINE_SERVER_IP:30120
# Option B: Cloudflare Tunnel (empfohlen, keine Portfreigabe nötig)
#   FIVEM_URL=https://fivem-api.deine-domain.de
FIVEM_URL=http://DEINE_SERVER_IP:30120

# Geheimer Token für die interne FiveM-API
# MUSS exakt mit Config.InternalSecret in der FiveM config.lua übereinstimmen!
# Generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIVEM_SECRET=HIER_GEHEIMEN_TOKEN_EINTRAGEN

# ── Session ──────────────────────────────────────────────────
# Zufälliger geheimer Schlüssel für Sessions
# Generieren: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=HIER_SESSION_SECRET_EINTRAGEN

# Session-Dauer in Millisekunden (Standard: 24 Stunden)
SESSION_MAX_AGE=86400000

# ── Discord OAuth2 ───────────────────────────────────────────
# Discord Developer Portal: https://discord.com/developers/applications
# 1. Neue Application erstellen
# 2. OAuth2 → Redirects → DISCORD_REDIRECT_URI eintragen
# 3. Client ID und Client Secret kopieren

DISCORD_CLIENT_ID=DEINE_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=DEIN_DISCORD_CLIENT_SECRET

# Muss exakt im Discord Developer Portal unter OAuth2 → Redirects eingetragen sein
DISCORD_REDIRECT_URI=https://api.deine-domain.de/auth/callback

# Discord Server-ID (Rechtsklick auf Server → ID kopieren)
DISCORD_GUILD_ID=DEINE_DISCORD_SERVER_ID

# Rollen-IDs die Zugang haben (kommagetrennt, leer = alle Server-Mitglieder)
# Rechtsklick auf Rolle → ID kopieren (Entwicklermodus muss aktiviert sein)
DISCORD_REQUIRED_ROLES=ROLLE_ID_1,ROLLE_ID_2

# ── API-Keys ─────────────────────────────────────────────────
# Format: APIKEY_N=secretkey:Name:permissions
# Permissions:
#   read    → Daten lesen (Spieler, Marker, Zonen, Events, Stats)
#   markers → read + Marker/Zonen erstellen und löschen
#   admin   → alles inkl. Admin-Endpunkte
#
# Key generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIKEY_1=DEIN_ERSTER_API_KEY:Mein Dashboard:read
# APIKEY_2=ZWEITER_KEY:Admin Tool:read,markers,admin

# ── Debug ────────────────────────────────────────────────────
# true = ausführliche Logs, false = nur Fehler
DEBUG=false

# Node.js Umgebung (production oder development)
NODE_ENV=production
